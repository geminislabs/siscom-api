# ============================================
# Archivo de ejemplo de variables de entorno
# Copia este archivo como .env y configura tus valores
# ============================================

# Información de la Aplicación
APP_NAME=siscom-api
APP_VERSION=0.1.0

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=tu_usuario
DB_PASSWORD=tu_password_seguro
DB_DATABASE=tu_database
DB_MIN_CONNECTIONS=10
DB_MAX_CONNECTIONS=20
DB_CONNECTION_TIMEOUT_SECS=30
DB_IDLE_TIMEOUT_SECS=300

# Seguridad JWT
JWT_SECRET_KEY=tu_clave_secreta_super_segura_aqui
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Seguridad PASETO — tokens de compartir ubicación (v4.local)
# Clave dedicada (base64 de 32 bytes). Es la que debe quedar a medio plazo.
SHARE_LOCATION_KEY_B64=tu_clave_dedicada_base64_de_32_bytes

# Clave HEREDADA, compartida con siscom-admin-api, que también firma sus tokens
# de servicio `internal-*`. Mientras esté presente, este servicio puede emitir
# tokens administrativos de admin-api. Solo durante la ventana de migración:
# vaciarla cierra la transición sin tocar código.
PASETO_SECRET_KEY=

# CORS (Cross-Origin Resource Sharing)
# Lista de orígenes permitidos separados por comas. OBLIGATORIO en producción.
# Usar "*" abre la API a cualquier origen y deshabilita las credenciales.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Documentación interactiva (/api/docs, /api/redoc, /api/openapi.json).
# Deshabilitada por defecto: publica el mapa completo de la API sin auth.
ENABLE_API_DOCS=false

# Kafka/Redpanda Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=siscom-minimal
KAFKA_GROUP_ID=siscom-api-consumer
KAFKA_AUTO_OFFSET_RESET=latest

KAFKA_USERNAME=tu_usuario_kafka
KAFKA_PASSWORD=tu_password_kafka

# Streaming WebSocket (OPCIONAL)
# Intervalo del ping keep-alive en segundos. Mantenerlo por debajo del idle
# timeout del proxy/ALB (default 60s) para evitar que corte sockets ociosos.
WEBSOCKET_KEEPALIVE_SECS=25

# StatsD/Telegraf (Métricas - OPCIONAL)
# Deshabilitar métricas (por defecto, sin errores)
STATSD_ENABLED=false

# Habilitar métricas (solo si tienes Telegraf/StatsD corriendo)
# STATSD_ENABLED=true
STATSD_HOST=localhost
STATSD_PORT=8126
STATSD_PREFIX=siscom_api
